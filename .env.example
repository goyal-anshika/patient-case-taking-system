APP_NAME=Patient Case Taking System
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/patient_case_db

SECRET_KEY=CHANGE_THIS_SECRET

# AI
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_MODEL=openrouter/auto

# Speech provider
SPEECH_PROVIDER=mock

# OCR
OCR_PROVIDER=paddleocr